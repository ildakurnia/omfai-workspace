DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files directly (JS, CSS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If directory exists, add trailing slash so Apache serves its index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ $1/ [R=302,L]

  # If a folder with index.html exists for this path, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # If a .html file exists for this path, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>
