<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika file asli ada (JS, CSS, gambar, dll), sajikan langsung
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Jika file .html ada untuk URL ini, sajikan file .html
  # Contoh: /piket/confirm → piket/confirm.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
